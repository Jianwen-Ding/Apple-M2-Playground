.version 7.0
.target sm_75
.address_size 64
// A per-thread array indexed by data (so it lives on the stack): ITERS read-modify-writes at scattered indices.
.visible .entry stackrw(.param .u64 out, .param .u32 iters)
{
	.local .align 4 .b8 arr[256];
	.reg .u32 %r<16>;
	.reg .u64 %rd<8>;
	.reg .pred %p<2>;
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mad.lo.u32 %r4, %r2, %r3, %r1;
	ld.param.u32 %r5, [iters];
	mov.u64 %rd1, arr;
	mov.u32 %r6, 0;
	mov.u32 %r7, %r1;
fill:
	and.b32 %r8, %r6, 63;
	mul.wide.u32 %rd2, %r8, 4;
	add.u64 %rd3, %rd1, %rd2;
	st.local.u32 [%rd3], %r6;
	add.u32 %r6, %r6, 1;
	setp.lt.u32 %p1, %r6, 64;
	@%p1 bra fill;
	mov.u32 %r6, 0;
loop:
	mad.lo.u32 %r7, %r7, 1103515245, 12345;
	shr.u32 %r8, %r7, 26;
	mul.wide.u32 %rd2, %r8, 4;
	add.u64 %rd3, %rd1, %rd2;
	ld.local.u32 %r9, [%rd3];
	add.u32 %r9, %r9, %r6;
	st.local.u32 [%rd3], %r9;
	add.u32 %r6, %r6, 1;
	setp.lt.u32 %p1, %r6, %r5;
	@%p1 bra loop;
	ld.local.u32 %r10, [%rd1];
	ld.param.u64 %rd4, [out];
	mul.wide.u32 %rd5, %r4, 4;
	add.u64 %rd6, %rd4, %rd5;
	st.global.u32 [%rd6], %r10;
	ret;
}
