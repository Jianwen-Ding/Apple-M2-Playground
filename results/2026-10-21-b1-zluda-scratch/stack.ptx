.version 7.0
.target sm_70
.address_size 64

// B1 through ZLUDA: a dynamically indexed 1 KiB .local array (forced onto the stack).
// out[gid] = idx * gid + idx with idx = (gid * 37) & 255, for gid < n.
.visible .entry stack_k(.param .u64 out, .param .u32 n)
{
    .local .align 4 .b8 arr[1024];
    .reg .u32 %r<12>;
    .reg .u64 %rd<10>;
    .reg .pred %p<3>;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.u32 %r4, %r2, %r3, %r1;
    ld.param.u32 %r10, [n];
    setp.ge.u32 %p2, %r4, %r10;
    @%p2 bra DONE;
    mov.u64 %rd2, arr;
    mov.u32 %r5, 0;
LOOP:
    mad.lo.u32 %r6, %r5, %r4, %r5;
    mul.wide.u32 %rd1, %r5, 4;
    add.u64 %rd3, %rd2, %rd1;
    st.local.u32 [%rd3], %r6;
    add.u32 %r5, %r5, 1;
    setp.lt.u32 %p1, %r5, 256;
    @%p1 bra LOOP;
    mul.lo.u32 %r7, %r4, 37;
    and.b32 %r7, %r7, 255;
    mul.wide.u32 %rd1, %r7, 4;
    add.u64 %rd3, %rd2, %rd1;
    ld.local.u32 %r8, [%rd3];
    ld.param.u64 %rd4, [out];
    cvta.to.global.u64 %rd4, %rd4;
    mul.wide.u32 %rd5, %r4, 4;
    add.u64 %rd6, %rd4, %rd5;
    st.global.u32 [%rd6], %r8;
DONE:
    ret;
}
