.version 7.0
.target sm_75
.address_size 64
// The tail of a block reduction, ITERS times: each of the workgroup's 4 SIMD-groups stores a value to shared memory,
// bar.sync, then every thread reads the 4 groups' words for its lane (MODE 0: others' words after the barrier; MODE 1:
// the same reads with no barrier; MODE 2: barrier, then only its own word) and adds them; bar.sync before the next
// store. One float per thread to out.
.visible .entry tail(.param .u32 iters, .param .u32 mode, .param .u64 out)
{
	.shared .align 4 .f32 sh[128];
	.reg .u32 %r<16>;
	.reg .u64 %rd<8>;
	.reg .f32 %f<12>;
	.reg .pred %p<4>;
	ld.param.u32 %r1, [iters];
	ld.param.u32 %r2, [mode];
	mov.u32 %r3, %tid.x;
	and.b32 %r4, %r3, 31;
	shr.u32 %r5, %r3, 5;
	mov.u32 %r6, sh;
	shl.b32 %r7, %r3, 2;
	add.u32 %r8, %r6, %r7;
	shl.b32 %r9, %r4, 2;
	add.u32 %r10, %r6, %r9;
	cvt.rn.f32.u32 %f1, %r3;
	mov.u32 %r11, 0;
	setp.eq.u32 %p1, %r2, 1;
	setp.eq.u32 %p2, %r2, 2;
loop:
	st.shared.f32 [%r8], %f1;
	@!%p1 bar.sync 0;
	@%p2 bra own;
	ld.shared.f32 %f2, [%r10];
	ld.shared.f32 %f3, [%r10+128];
	ld.shared.f32 %f4, [%r10+256];
	ld.shared.f32 %f5, [%r10+384];
	add.f32 %f6, %f2, %f3;
	add.f32 %f7, %f4, %f5;
	add.f32 %f8, %f6, %f7;
	bra next;
own:
	ld.shared.f32 %f8, [%r8];
next:
	fma.rn.f32 %f1, %f8, 0f3E800000, %f1;
	@!%p1 bar.sync 0;
	add.u32 %r11, %r11, 1;
	setp.lt.u32 %p3, %r11, %r1;
	@%p3 bra loop;
	mov.u32 %r12, %ctaid.x;
	mad.lo.u32 %r13, %r12, 128, %r3;
	ld.param.u64 %rd1, [out];
	mul.wide.u32 %rd2, %r13, 4;
	add.u64 %rd3, %rd1, %rd2;
	st.global.f32 [%rd3], %f1;
	ret;
}
