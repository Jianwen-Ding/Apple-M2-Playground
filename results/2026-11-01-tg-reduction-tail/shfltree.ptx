.version 7.0
.target sm_75
.address_size 64
// ITERS times: C values (1 or 8) reduced over the SIMD-group by a 5-step shfl.sync.bfly + add tree (mul_mat_vec_q's
// tail); the _tg kernels first store the values to shared memory, bar.sync, read another group's slice, and bar.sync
// after the tree. Workgroups of 64 threads (2 SIMD-groups), as mul_mat_vec_q.
.visible .entry tree1(.param .u32 iters, .param .u64 out)
{
	.reg .u32 %r<16>;
	.reg .u64 %rd<8>;
	.reg .f32 %v<3>;
	.reg .f32 %t<4>;
	.reg .pred %p;
	ld.param.u32 %r1, [iters];
	mov.u32 %r3, %tid.x;
	mov.u32 %r11, 0;
	cvt.rn.f32.u32 %v0, %r3;
loop:
	shfl.sync.bfly.b32 %t0, %v0, 16, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 8, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 4, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 2, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 1, 31, -1;
	add.f32 %v0, %v0, %t0;
	mul.f32 %v0, %v0, 0f3D000000;
	add.u32 %r11, %r11, 1;
	setp.lt.u32 %p, %r11, %r1;
	@%p bra loop;
	mov.u32 %r12, %ctaid.x;
	mad.lo.u32 %r13, %r12, %ntid.x, %r3;
	ld.param.u64 %rd1, [out];
	mul.wide.u32 %rd2, %r13, 4;
	add.u64 %rd3, %rd1, %rd2;
	st.global.f32 [%rd3], %v0;
	ret;
}
.visible .entry tree1_tg(.param .u32 iters, .param .u64 out)
{
	.shared .align 4 .f32 sh[512];
	.reg .u32 %r<16>;
	.reg .u64 %rd<8>;
	.reg .f32 %v<3>;
	.reg .f32 %t<4>;
	.reg .pred %p;
	ld.param.u32 %r1, [iters];
	mov.u32 %r3, %tid.x;
	mov.u32 %r11, 0;
	cvt.rn.f32.u32 %v0, %r3;
	mov.u32 %r6, sh;
	shl.b32 %r7, %r3, 2;
	add.u32 %r8, %r6, %r7;
loop:
	st.shared.f32 [%r8+0], %v0;
	bar.sync 0;
	ld.shared.f32 %v0, [%r8+0];
	shfl.sync.bfly.b32 %t0, %v0, 16, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 8, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 4, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 2, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 1, 31, -1;
	add.f32 %v0, %v0, %t0;
	mul.f32 %v0, %v0, 0f3D000000;
	bar.sync 0;
	add.u32 %r11, %r11, 1;
	setp.lt.u32 %p, %r11, %r1;
	@%p bra loop;
	mov.u32 %r12, %ctaid.x;
	mad.lo.u32 %r13, %r12, %ntid.x, %r3;
	ld.param.u64 %rd1, [out];
	mul.wide.u32 %rd2, %r13, 4;
	add.u64 %rd3, %rd1, %rd2;
	st.global.f32 [%rd3], %v0;
	ret;
}
