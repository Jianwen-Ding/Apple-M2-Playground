.version 7.0
.target sm_75
.address_size 64
// One-shot reduction tail after a streaming phase (mul_mat_vec_q's shape): workgroups of 64 (2 SIMD-groups); each group
// reads ITERS x 128 bytes of its own window of a, accumulating C partials; then (tail1 / tail8) group 1 stores its C
// partials to shared memory, bar.sync, group 0 adds them, reduces each by a 5-step shfl.sync.bfly tree, and lane 0
// stores C floats. tail0: no tail (each thread stores its partial).
.visible .entry tail0(.param .u64 a, .param .u32 iters, .param .u64 out)
{
	.shared .align 4 .f32 sh[512];
	.reg .u32 %r<20>;
	.reg .u64 %rd<12>;
	.reg .f32 %v<3>;
	.reg .f32 %t<4>;
	.reg .f32 %x<4>;
	.reg .pred %p<4>;
	ld.param.u64 %rd1, [a];
	ld.param.u32 %r1, [iters];
	mov.u32 %r3, %tid.x;
	mov.u32 %r2, %ctaid.x;
	and.b32 %r4, %r3, 31;
	shr.u32 %r5, %r3, 5;
	shl.b32 %r6, %r2, 1;
	add.u32 %r6, %r6, %r5;
	mul.lo.u32 %r7, %r6, %r1;
	shl.b32 %r7, %r7, 5;
	add.u32 %r7, %r7, %r4;
	mul.wide.u32 %rd2, %r7, 4;
	add.u64 %rd3, %rd1, %rd2;
	mov.u32 %r11, 0;
	mov.f32 %v0, 0f00000000;
loop:
	ld.global.f32 %x0, [%rd3];
	fma.rn.f32 %v0, %x0, 0f3F800000, %v0;
	add.u64 %rd3, %rd3, 128;
	add.u32 %r11, %r11, 1;
	setp.lt.u32 %p1, %r11, %r1;
	@%p1 bra loop;
	ld.param.u64 %rd4, [out];
	mov.u32 %r13, %ntid.x;
	mad.lo.u32 %r12, %r2, %r13, %r3;
	mul.wide.u32 %rd5, %r12, 4;
	add.u64 %rd6, %rd4, %rd5;
	st.global.f32 [%rd6], %v0;
	ret;
}
.visible .entry tail1(.param .u64 a, .param .u32 iters, .param .u64 out)
{
	.shared .align 4 .f32 sh[512];
	.reg .u32 %r<20>;
	.reg .u64 %rd<12>;
	.reg .f32 %v<3>;
	.reg .f32 %t<4>;
	.reg .f32 %x<4>;
	.reg .pred %p<4>;
	ld.param.u64 %rd1, [a];
	ld.param.u32 %r1, [iters];
	mov.u32 %r3, %tid.x;
	mov.u32 %r2, %ctaid.x;
	and.b32 %r4, %r3, 31;
	shr.u32 %r5, %r3, 5;
	shl.b32 %r6, %r2, 1;
	add.u32 %r6, %r6, %r5;
	mul.lo.u32 %r7, %r6, %r1;
	shl.b32 %r7, %r7, 5;
	add.u32 %r7, %r7, %r4;
	mul.wide.u32 %rd2, %r7, 4;
	add.u64 %rd3, %rd1, %rd2;
	mov.u32 %r11, 0;
	mov.f32 %v0, 0f00000000;
loop:
	ld.global.f32 %x0, [%rd3];
	fma.rn.f32 %v0, %x0, 0f3F800000, %v0;
	add.u64 %rd3, %rd3, 128;
	add.u32 %r11, %r11, 1;
	setp.lt.u32 %p1, %r11, %r1;
	@%p1 bra loop;
	mov.u32 %r8, sh;
	shl.b32 %r9, %r4, 2;
	add.u32 %r9, %r8, %r9;
	setp.eq.u32 %p2, %r5, 1;
	@%p2 st.shared.f32 [%r9+0], %v0;
	bar.sync 0;
	@%p2 bra done;
	ld.shared.f32 %t1, [%r9+0];
	add.f32 %v0, %v0, %t1;
	shfl.sync.bfly.b32 %t0, %v0, 16, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 8, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 4, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 2, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 1, 31, -1;
	add.f32 %v0, %v0, %t0;
	setp.ne.u32 %p3, %r4, 0;
	@%p3 bra done;
	ld.param.u64 %rd4, [out];
	mul.lo.u32 %r12, %r2, 1;
	mul.wide.u32 %rd5, %r12, 4;
	add.u64 %rd6, %rd4, %rd5;
	st.global.f32 [%rd6+0], %v0;
done:
	ret;
}
.visible .entry tail8(.param .u64 a, .param .u32 iters, .param .u64 out)
{
	.shared .align 4 .f32 sh[512];
	.reg .u32 %r<20>;
	.reg .u64 %rd<12>;
	.reg .f32 %v<10>;
	.reg .f32 %t<4>;
	.reg .f32 %x<4>;
	.reg .pred %p<4>;
	ld.param.u64 %rd1, [a];
	ld.param.u32 %r1, [iters];
	mov.u32 %r3, %tid.x;
	mov.u32 %r2, %ctaid.x;
	and.b32 %r4, %r3, 31;
	shr.u32 %r5, %r3, 5;
	shl.b32 %r6, %r2, 1;
	add.u32 %r6, %r6, %r5;
	mul.lo.u32 %r7, %r6, %r1;
	shl.b32 %r7, %r7, 5;
	add.u32 %r7, %r7, %r4;
	mul.wide.u32 %rd2, %r7, 4;
	add.u64 %rd3, %rd1, %rd2;
	mov.u32 %r11, 0;
	mov.f32 %v0, 0f00000000;
	mov.f32 %v1, 0f00000000;
	mov.f32 %v2, 0f00000000;
	mov.f32 %v3, 0f00000000;
	mov.f32 %v4, 0f00000000;
	mov.f32 %v5, 0f00000000;
	mov.f32 %v6, 0f00000000;
	mov.f32 %v7, 0f00000000;
