	add.f32 %v5, %v5, %t0;
	shfl.sync.bfly.b32 %t0, %v6, 4, 31, -1;
	add.f32 %v6, %v6, %t0;
	shfl.sync.bfly.b32 %t0, %v7, 4, 31, -1;
	add.f32 %v7, %v7, %t0;
	shfl.sync.bfly.b32 %t0, %v0, 2, 31, -1;
	add.f32 %v0, %v0, %t0;
