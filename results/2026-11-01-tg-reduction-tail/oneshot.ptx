	setp.lt.u32 %p1, %r11, %r1;
	@%p1 bra loop;
	mov.u32 %r8, sh;
	shl.b32 %r9, %r4, 2;
	add.u32 %r9, %r8, %r9;
	setp.eq.u32 %p2, %r5, 1;
	@%p2 st.shared.f32 [%r9+0], %v0;
	@%p2 st.shared.f32 [%r9+128], %v1;
	@%p2 st.shared.f32 [%r9+256], %v2;
	@%p2 st.shared.f32 [%r9+384], %v3;
	@%p2 st.shared.f32 [%r9+512], %v4;
	@%p2 st.shared.f32 [%r9+640], %v5;
	@%p2 st.shared.f32 [%r9+768], %v6;
	@%p2 st.shared.f32 [%r9+896], %v7;
	bar.sync 0;
	@%p2 bra done;
	ld.shared.f32 %t1, [%r9+0];
	add.f32 %v0, %v0, %t1;
	ld.shared.f32 %t1, [%r9+128];
	add.f32 %v1, %v1, %t1;
	ld.shared.f32 %t1, [%r9+256];
	add.f32 %v2, %v2, %t1;
	ld.shared.f32 %t1, [%r9+384];
	add.f32 %v3, %v3, %t1;
	ld.shared.f32 %t1, [%r9+512];
	add.f32 %v4, %v4, %t1;
	ld.shared.f32 %t1, [%r9+640];
	add.f32 %v5, %v5, %t1;
	ld.shared.f32 %t1, [%r9+768];
	add.f32 %v6, %v6, %t1;
	ld.shared.f32 %t1, [%r9+896];
	add.f32 %v7, %v7, %t1;
	shfl.sync.bfly.b32 %t0, %v0, 16, 31, -1;
	add.f32 %v0, %v0, %t0;
	shfl.sync.bfly.b32 %t0, %v1, 16, 31, -1;
	add.f32 %v1, %v1, %t0;
	shfl.sync.bfly.b32 %t0, %v2, 16, 31, -1;
	add.f32 %v2, %v2, %t0;
	shfl.sync.bfly.b32 %t0, %v3, 16, 31, -1;
	add.f32 %v3, %v3, %t0;
	shfl.sync.bfly.b32 %t0, %v4, 16, 31, -1;
	add.f32 %v4, %v4, %t0;
	shfl.sync.bfly.b32 %t0, %v5, 16, 31, -1;
	add.f32 %v5, %v5, %t0;
	shfl.sync.bfly.b32 %t0, %v6, 16, 31, -1;
	add.f32 %v6, %v6, %t0;
	shfl.sync.bfly.b32 %t0, %v7, 16, 31, -1;
	add.f32 %v7, %v7, %t0;
