.version 7.0
.target sm_75
.address_size 64
// Device-memory twin of stackmix: each SIMD group's "stack" at buf + wg * cstride + group * slot, word w of lane l
// at + w * 128 + 4 * l (the scratch layout); per trip 3 loads + 1 store (st != 0) of words 4i..4i+3 masked;
// workgroups outside [lo, hi) return at once.
.visible .entry devmix(.param .u64 buf, .param .u32 iters, .param .u32 mask, .param .u32 st, .param .u32 cstride, .param .u32 slot, .param .u32 lo, .param .u32 hi)
{
	.reg .u32 %r<40>;
	.reg .u64 %rd<20>;
	.reg .pred %p<3>;
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, %ctaid.x;
	ld.param.u32 %r20, [lo];
	ld.param.u32 %r21, [hi];
	setp.lt.u32 %p1, %r2, %r20;
	@%p1 bra done;
	setp.ge.u32 %p1, %r2, %r21;
	@%p1 bra done;
	ld.param.u32 %r5, [iters];
	ld.param.u32 %r11, [mask];
	ld.param.u32 %r12, [st];
	ld.param.u32 %r22, [cstride];
	ld.param.u32 %r23, [slot];
	setp.ne.u32 %p2, %r12, 0;
	ld.param.u64 %rd1, [buf];
	mul.wide.u32 %rd2, %r2, %r22;
	add.u64 %rd1, %rd1, %rd2;
	shr.u32 %r24, %r1, 5;
	mul.wide.u32 %rd2, %r24, %r23;
	add.u64 %rd1, %rd1, %rd2;
	and.b32 %r25, %r1, 31;
	mul.wide.u32 %rd2, %r25, 4;
	add.u64 %rd1, %rd1, %rd2;
	mov.u32 %r6, 0;
	mov.u32 %r10, 0;
loop:
	mul.lo.u32 %r7, %r6, 4;
	and.b32 %r8, %r7, %r11;
	mul.wide.u32 %rd3, %r8, 128;
	add.u64 %rd3, %rd1, %rd3;
	ld.global.u32 %r13, [%rd3];
	add.u32 %r9, %r7, 1;
	and.b32 %r9, %r9, %r11;
	mul.wide.u32 %rd4, %r9, 128;
	add.u64 %rd4, %rd1, %rd4;
	ld.global.u32 %r14, [%rd4];
	add.u32 %r15, %r7, 2;
	and.b32 %r15, %r15, %r11;
	mul.wide.u32 %rd5, %r15, 128;
	add.u64 %rd5, %rd1, %rd5;
	ld.global.u32 %r16, [%rd5];
	add.u32 %r17, %r13, %r14;
	add.u32 %r17, %r17, %r16;
	add.u32 %r10, %r10, %r17;
	add.u32 %r18, %r7, 3;
	and.b32 %r18, %r18, %r11;
	mul.wide.u32 %rd6, %r18, 128;
	add.u64 %rd6, %rd1, %rd6;
	@%p2 st.global.u32 [%rd6], %r17;
	add.u32 %r6, %r6, 1;
	setp.lt.u32 %p1, %r6, %r5;
	@%p1 bra loop;
	st.global.u32 [%rd1], %r10;
done:
	ret;
}
