.version 7.0
.target sm_75
.address_size 64
// Stack traffic probe (MMQ-like spills): a 1 KiB per-thread .local array, lane-uniform indices from the loop counter
// and a runtime mask, per trip 3 stack loads + `st` stack stores (0 or 1), so the footprint per thread is
// 4 * (mask + 1) bytes and stays on the stack.
.visible .entry stackrng(.param .u64 out, .param .u32 iters, .param .u32 mask, .param .u32 st, .param .u32 lo, .param .u32 hi)
{
	.local .align 4 .b8 arr[1024];
	.reg .u32 %r<24>;
	.reg .u64 %rd<12>;
	.reg .pred %p<3>;
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mad.lo.u32 %r4, %r2, %r3, %r1;
	ld.param.u32 %r20, [lo];
	ld.param.u32 %r21, [hi];
	setp.lt.u32 %p1, %r2, %r20;
	@%p1 bra done;
	setp.ge.u32 %p1, %r2, %r21;
	@%p1 bra done;
	ld.param.u32 %r5, [iters];
	ld.param.u32 %r11, [mask];
	ld.param.u32 %r12, [st];
	setp.ne.u32 %p2, %r12, 0;
	mov.u64 %rd1, arr;
	mov.u32 %r6, 0;
fill:
	mul.wide.u32 %rd2, %r6, 4;
	add.u64 %rd3, %rd1, %rd2;
	st.local.u32 [%rd3], %r1;
	add.u32 %r6, %r6, 1;
	setp.lt.u32 %p1, %r6, 256;
	@%p1 bra fill;
	mov.u32 %r6, 0;
	mov.u32 %r10, 0;
loop:
	mul.lo.u32 %r7, %r6, 4;
	and.b32 %r8, %r7, %r11;
	mul.wide.u32 %rd2, %r8, 4;
	add.u64 %rd3, %rd1, %rd2;
	ld.local.u32 %r13, [%rd3];
	add.u32 %r9, %r7, 1;
	and.b32 %r9, %r9, %r11;
	mul.wide.u32 %rd4, %r9, 4;
	add.u64 %rd5, %rd1, %rd4;
	ld.local.u32 %r14, [%rd5];
	add.u32 %r15, %r7, 2;
	and.b32 %r15, %r15, %r11;
	mul.wide.u32 %rd6, %r15, 4;
	add.u64 %rd7, %rd1, %rd6;
	ld.local.u32 %r16, [%rd7];
	add.u32 %r17, %r13, %r14;
	add.u32 %r17, %r17, %r16;
	add.u32 %r10, %r10, %r17;
	add.u32 %r18, %r7, 3;
	and.b32 %r18, %r18, %r11;
	mul.wide.u32 %rd8, %r18, 4;
	add.u64 %rd9, %rd1, %rd8;
	@%p2 st.local.u32 [%rd9], %r17;
	add.u32 %r6, %r6, 1;
	setp.lt.u32 %p1, %r6, %r5;
	@%p1 bra loop;
	ld.param.u64 %rd4, [out];
	mul.wide.u32 %rd5, %r4, 4;
	add.u64 %rd6, %rd4, %rd5;
	st.global.u32 [%rd6], %r10;
done:
	ret;
}
