.version 7.0
.target sm_75
.address_size 64
// Each thread stores 16 words, 1556480 bytes apart (the grid is 1520 x 256): 16 x 1.5 MB written in all.
.visible .entry stn16(.param .u64 out)
{
	.reg .u32 %r<5>;
	.reg .u64 %rd<4>;
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mad.lo.u32 %r4, %r2, %r3, %r1;
	ld.param.u64 %rd1, [out];
	mul.wide.u32 %rd2, %r4, 4;
	add.u64 %rd3, %rd1, %rd2;
	st.global.u32 [%rd3+0], %r4;
	st.global.u32 [%rd3+1556480], %r4;
	st.global.u32 [%rd3+3112960], %r4;
	st.global.u32 [%rd3+4669440], %r4;
	st.global.u32 [%rd3+6225920], %r4;
	st.global.u32 [%rd3+7782400], %r4;
	st.global.u32 [%rd3+9338880], %r4;
	st.global.u32 [%rd3+10895360], %r4;
	st.global.u32 [%rd3+12451840], %r4;
	st.global.u32 [%rd3+14008320], %r4;
	st.global.u32 [%rd3+15564800], %r4;
	st.global.u32 [%rd3+17121280], %r4;
	st.global.u32 [%rd3+18677760], %r4;
	st.global.u32 [%rd3+20234240], %r4;
	st.global.u32 [%rd3+21790720], %r4;
	st.global.u32 [%rd3+23347200], %r4;
	ret;
}
