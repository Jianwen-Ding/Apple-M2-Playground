.version 7.0
.target sm_75
.address_size 64
// Each thread stores its index (4 bytes) at out[global id]: the least a kernel that writes does.
.visible .entry st(.param .u64 out)
{
	.reg .u32 %r<5>;
	.reg .u64 %rd<4>;
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mad.lo.u32 %r4, %r2, %r3, %r1;
	ld.param.u64 %rd1, [out];
	mul.wide.u32 %rd2, %r4, 4;
	add.u64 %rd3, %rd1, %rd2;
	st.global.u32 [%rd3], %r4;
	ret;
}
