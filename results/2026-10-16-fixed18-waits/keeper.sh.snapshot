#!/bin/sh
# keeps the GPU clock up: 64-lane delay kernel, 64 commands per SUBMIT, until /scratch/apple-m2-playground/drm-compute/keeper/stop exists (max 200 processes)
i=0; while [ ! -e /scratch/apple-m2-playground/drm-compute/keeper/stop ] && [ $i -lt 200 ]; do AGX_CMDS=64 AGX_CMD_BARRIER=none timeout 30 /scratch/apple-m2-playground/drm-compute/keeper/drm_compute /dev/dri/renderD128 /scratch/apple-m2-playground/drm-compute/keeper/k.bin 64 /scratch/apple-m2-playground/drm-compute/keeper/rb 32 16 > /scratch/apple-m2-playground/drm-compute/keeper/last.out 2>&1 || echo FAIL >> /scratch/apple-m2-playground/drm-compute/keeper/log; grep -q completed /scratch/apple-m2-playground/drm-compute/keeper/last.out && echo ok >> /scratch/apple-m2-playground/drm-compute/keeper/log; i=$((i+1)); done
